rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function schoolPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId);
    }

    function studentPath(schoolId, uid) {
      return /databases/$(database)/documents/schools/$(schoolId)/students/$(uid);
    }

    function teacherPath(schoolId, uid) {
      return /databases/$(database)/documents/schools/$(schoolId)/teachers/$(uid);
    }

    function adminPath(schoolId, uid) {
      return /databases/$(database)/documents/schools/$(schoolId)/admins/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function profile() {
      return get(userPath(request.auth.uid)).data;
    }

    function hasProfileAfterWrite() {
      return signedIn() && existsAfter(userPath(request.auth.uid));
    }

    function profileAfterWrite() {
      return getAfter(userPath(request.auth.uid)).data;
    }

    function sameSchool(schoolId) {
      return hasProfile() && profile().schoolId == schoolId;
    }

    function sameSchoolAfterWrite(schoolId) {
      return hasProfileAfterWrite() && profileAfterWrite().schoolId == schoolId;
    }

    function schoolStaff(schoolId) {
      return sameSchool(schoolId) && profile().role in ["teacher", "admin"];
    }

    function schoolAdmin(schoolId) {
      return sameSchool(schoolId) && profile().role == "admin";
    }

    function validRole(role) {
      return role in ["student", "teacher", "admin"];
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function exploreModerator() {
      return signedIn()
        && request.auth.token.email == "studiesduhhh@gmail.com";
    }

    function hasMatchingMembershipAfter(userId) {
      let schoolId = request.resource.data.schoolId;
      let role = request.resource.data.role;
      return (
          role == "student"
          && existsAfter(studentPath(schoolId, userId))
          && getAfter(studentPath(schoolId, userId)).data.uid == userId
          && getAfter(studentPath(schoolId, userId)).data.role == role
          && getAfter(studentPath(schoolId, userId)).data.schoolId == schoolId
          && getAfter(studentPath(schoolId, userId)).data.email == request.auth.token.email
        )
        || (
          role == "teacher"
          && existsAfter(teacherPath(schoolId, userId))
          && getAfter(teacherPath(schoolId, userId)).data.uid == userId
          && getAfter(teacherPath(schoolId, userId)).data.role == role
          && getAfter(teacherPath(schoolId, userId)).data.schoolId == schoolId
          && getAfter(teacherPath(schoolId, userId)).data.email == request.auth.token.email
        )
        || (
          role == "admin"
          && existsAfter(adminPath(schoolId, userId))
          && getAfter(adminPath(schoolId, userId)).data.uid == userId
          && getAfter(adminPath(schoolId, userId)).data.role == role
          && getAfter(adminPath(schoolId, userId)).data.schoolId == schoolId
          && getAfter(adminPath(schoolId, userId)).data.email == request.auth.token.email
          && existsAfter(schoolPath(schoolId))
          && getAfter(schoolPath(schoolId)).data.adminIds.hasAny([userId])
        );
    }

    function createsOwnUserProfile(userId) {
      return ownsProfile(userId)
        && request.resource.data.uid == request.auth.uid
        && validRole(request.resource.data.role)
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId != "public-gallery"
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && hasMatchingMembershipAfter(userId);
    }

    function safeProjectWrite(schoolId) {
      return signedIn()
        && request.resource.data.schoolId == schoolId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.visibility == "public"
        && (schoolId == "public-gallery" || sameSchool(schoolId))
        && (
          schoolId == "public-gallery"
          || (
            request.resource.data.get("grade", "Not graded") == "Not graded"
            && request.resource.data.get("feedback", "") == ""
            && !request.resource.data.keys().hasAny([
              "gradedAt",
              "gradedById",
              "gradedByName",
              "autoGrade"
            ])
          )
        );
    }

    function preservesTeacherAssessment() {
      return request.resource.data.get("grade", "Not graded")
          == resource.data.get("grade", "Not graded")
        && request.resource.data.get("feedback", "")
          == resource.data.get("feedback", "")
        && request.resource.data.get("gradedAt", null)
          == resource.data.get("gradedAt", null)
        && request.resource.data.get("gradedById", "")
          == resource.data.get("gradedById", "")
        && request.resource.data.get("gradedByName", "")
          == resource.data.get("gradedByName", "")
        && request.resource.data.get("autoGrade", null)
          == resource.data.get("autoGrade", null);
    }

    function preservesGalleryReactions(schoolId) {
      return schoolId != "public-gallery"
        || (
          request.resource.data.get("likeCount", 0)
            == resource.data.get("likeCount", 0)
          && request.resource.data.get("likedBy", [])
            == resource.data.get("likedBy", [])
        );
    }

    function ownerProjectUpdate(schoolId) {
      return signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.schoolId == schoolId
        && request.resource.data.visibility == "public"
        && (schoolId == "public-gallery" || sameSchool(schoolId))
        && (
          schoolId == "public-gallery"
          || preservesTeacherAssessment()
        )
        && preservesGalleryReactions(schoolId);
    }

    function staffProjectUpdate(schoolId) {
      return schoolStaff(schoolId)
        && resource.data.schoolId == schoolId
        && request.resource.data.schoolId == schoolId
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    function preservesMemberIdentity(memberId, role, schoolId) {
      return request.resource.data.get("uid", memberId)
          == resource.data.get("uid", memberId)
        && request.resource.data.get("role", role)
          == resource.data.get("role", role)
        && request.resource.data.get("schoolId", schoolId)
          == resource.data.get("schoolId", schoolId)
        && request.resource.data.get("email", "")
          == resource.data.get("email", "");
    }

    function publicLikeOnly(schoolId) {
      let before = resource.data.get("likedBy", []);
      let after = request.resource.data.get("likedBy", []);
      let userId = request.auth.uid;

      return signedIn()
        && schoolId == "public-gallery"
        && resource.data.visibility == "public"
        && request.resource.data.visibility == "public"
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "likeCount",
          "likedBy",
          "updatedAt"
        ])
        && (
          (
            !before.hasAny([userId])
            && after.hasAny([userId])
            && after.size() == before.size() + 1
            && after.toSet().difference(before.toSet()).hasOnly([userId])
            && before.toSet().difference(after.toSet()).size() == 0
            && request.resource.data.likeCount
              == resource.data.get("likeCount", 0) + 1
          )
          || (
            before.hasAny([userId])
            && !after.hasAny([userId])
            && after.size() == before.size() - 1
            && before.toSet().difference(after.toSet()).hasOnly([userId])
            && after.toSet().difference(before.toSet()).size() == 0
            && request.resource.data.likeCount
              == resource.data.get("likeCount", 0) - 1
          )
        );
    }

    match /users/{userId} {
      allow create: if createsOwnUserProfile(userId);
      allow get: if ownsProfile(userId) || (hasProfile() && resource.data.schoolId == profile().schoolId);
      allow list: if hasProfile() && resource.data.schoolId == profile().schoolId;
      allow update: if ownsProfile(userId)
        && request.resource.data.get("uid", request.auth.uid) == request.auth.uid
        && request.resource.data.get("schoolId", "")
          == resource.data.get("schoolId", "")
        && request.resource.data.get("role", "")
          == resource.data.get("role", "")
        && request.resource.data.get("email", "")
          == resource.data.get("email", "")
        && request.resource.data.get("email", "") == request.auth.token.email;
      allow delete: if false;
    }

    match /schools/{schoolId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.id == schoolId
        && hasProfileAfterWrite()
        && profileAfterWrite().schoolId == schoolId
        && (
          (
            profileAfterWrite().role == "admin"
            && request.resource.data.adminIds.hasOnly([request.auth.uid])
            && request.resource.data.adminIds.hasAll([request.auth.uid])
          )
          || (
            profileAfterWrite().role in ["student", "teacher"]
            && request.resource.data.selfServiceSignup == true
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdByRole == profileAfterWrite().role
            && request.resource.data.adminIds.size() == 0
          )
        );

      allow update: if schoolAdmin(schoolId)
        || (
          signedIn()
          && resource.data.adminIds.size() == 0
          && request.resource.data.id == schoolId
          && sameSchoolAfterWrite(schoolId)
          && profileAfterWrite().role == "admin"
          && request.resource.data.adminIds.size() == 1
          && request.resource.data.adminIds.hasOnly([request.auth.uid])
          && request.resource.data.adminIds.hasAll([request.auth.uid])
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "adminIds",
            "updatedAt",
            "leaderboardEnabled",
            "name",
            "id"
          ])
        )
        || (
          sameSchoolAfterWrite(schoolId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["updatedAt"])
        );

      allow delete: if false;

      match /admins/{adminId} {
        allow read: if ownsProfile(adminId) || schoolStaff(schoolId);
        allow create: if ownsProfile(adminId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == "admin"
          && request.resource.data.schoolId == schoolId
          && request.resource.data.email == request.auth.token.email
          && hasProfileAfterWrite()
          && profileAfterWrite().role == "admin"
          && profileAfterWrite().schoolId == schoolId
          && existsAfter(schoolPath(schoolId))
          && getAfter(schoolPath(schoolId)).data.adminIds.hasAny([adminId]);
        allow update: if preservesMemberIdentity(adminId, "admin", schoolId)
          && (ownsProfile(adminId) || schoolAdmin(schoolId));
        allow delete: if false;
      }

      match /teachers/{teacherId} {
        allow read: if ownsProfile(teacherId) || schoolStaff(schoolId);
        allow create: if ownsProfile(teacherId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == "teacher"
          && request.resource.data.schoolId == schoolId
          && request.resource.data.email == request.auth.token.email
          && hasProfileAfterWrite()
          && profileAfterWrite().role == "teacher"
          && profileAfterWrite().schoolId == schoolId;
        allow update: if preservesMemberIdentity(teacherId, "teacher", schoolId)
          && (ownsProfile(teacherId) || schoolAdmin(schoolId));
        allow delete: if false;
      }

      match /students/{studentId} {
        allow read: if ownsProfile(studentId) || schoolStaff(schoolId);
        allow create: if ownsProfile(studentId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == "student"
          && request.resource.data.schoolId == schoolId
          && request.resource.data.email == request.auth.token.email
          && hasProfileAfterWrite()
          && profileAfterWrite().role == "student"
          && profileAfterWrite().schoolId == schoolId;
        allow update: if preservesMemberIdentity(studentId, "student", schoolId)
          && (ownsProfile(studentId) || schoolStaff(schoolId));
        allow delete: if false;
      }

      match /assignments/{assignmentId} {
        allow read: if sameSchool(schoolId);
        allow create, update: if schoolStaff(schoolId)
          && request.resource.data.schoolId == schoolId
          && request.resource.data.createdById == request.auth.uid;
        allow delete: if schoolAdmin(schoolId);
      }

      match /projects/{projectId} {
        allow read: if (
            schoolId == "public-gallery"
            && resource.data.visibility == "public"
          )
          || (signedIn() && resource.data.ownerId == request.auth.uid)
          || schoolStaff(schoolId);

        allow create: if safeProjectWrite(schoolId);

        allow update: if publicLikeOnly(schoolId)
          || ownerProjectUpdate(schoolId)
          || staffProjectUpdate(schoolId);

        allow delete: if (
            schoolId == "public-gallery"
            && exploreModerator()
          )
          || (
            schoolId != "public-gallery"
            && signedIn()
            && (
              resource.data.ownerId == request.auth.uid
              || schoolAdmin(schoolId)
            )
          );
      }
    }
  }
}
